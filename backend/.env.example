# ---- Required ---------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Public URL of this API (used to build media URLs and legal-page links)
PUBLIC_BASE_URL=https://api.yourdomain.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/clipzy
# Set true for managed Postgres that requires TLS (Neon, Supabase, Render, Railway, RDS...)
DATABASE_SSL=true
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---- Video/image storage (S3-compatible) -------------------------------------
STORAGE_DRIVER=s3
S3_BUCKET=clipzy-media
S3_REGION=auto
# Leave empty for AWS S3. For Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public/CDN URL that serves the bucket, no trailing slash. Example: https://cdn.yourdomain.com
MEDIA_BASE_URL=

# ---- Optional -----------------------------------------------------------------
# Comma-separated Google OAuth client IDs (the Web client ID, plus iOS/Android IDs if you use them)
GOOGLE_CLIENT_IDS=
# Secret for the moderation endpoints (x-admin-key header). Generate like JWT_SECRET.
# 32+ random characters; required in production to moderate reports.
ADMIN_API_KEY=
CORS_ORIGINS=*
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_DAYS=30
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=180

# ---- Shown on /privacy /terms /support pages (required by app stores) -------------
APP_NAME=Clipzy
COMPANY_NAME=Your Company Ltd
SUPPORT_EMAIL=support@yourdomain.com
