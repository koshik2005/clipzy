{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://YOUR-LAN-IP:4000" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://clipzy-api.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "930359673034-pcm4k982f5plogaecnp27mt3vvufuoa8.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://clipzy-api.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "930359673034-pcm4k982f5plogaecnp27mt3vvufuoa8.apps.googleusercontent.com",
        "EXPO_PUBLIC_MAX_VIDEO_SECONDS": "180"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "you@example.com",
        "ascAppId": "APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
