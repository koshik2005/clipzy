# Base URL of your deployed API (no trailing slash). On a physical device in dev use your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Optional: enables the "Continue with Google" button on Android. Use the *Web* OAuth client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Keep in sync with MAX_VIDEO_SECONDS on the API
EXPO_PUBLIC_MAX_VIDEO_SECONDS=180
